{% extends 'base.html.twig' %}

{% block title %}Volontaire{% endblock %}

{% block body %}
    <h1>Volontaire</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ volontaire.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ volontaire.name }}</td>
            </tr>
            <tr>
                <th>LastName</th>
                <td>{{ volontaire.lastName }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ volontaire.email }}</td>
            </tr>
            <tr>
                <th>PhoneNum</th>
                <td>{{ volontaire.phoneNum }}</td>
            </tr>
            <tr>
                <th>Skills</th>
                <td>{{ volontaire.skills }}</td>
            </tr>
            <tr>
                <th>Availability</th>
                <td>{{ volontaire.availability ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>

    <a name="button-a" href="{{ path('app_volontaire_index') }}" class="btn-back">back to list</a>

    <a name="button-a" href="{{ path('app_volontaire_edit', {'id': volontaire.id}) }}">edit</a>

    {{ include('volontaire/_delete_form.html.twig', { 'class': 'btn-delete' }) }}
{% endblock %}
