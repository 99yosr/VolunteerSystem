{% extends 'base.html.twig' %}

{% block title %}Volontaire index{% endblock %}

{% block body %}
    <h1>Liste Des Volontaires</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Prénom</th>
                <th>Npm</th>
                <th>Email</th>
                <th>N° Téléphone</th>
                <th>Compétances</th>
                <th>Disponibilité</th>
                <th style="width: 150px;">Actions</th>

            </tr>
        </thead>
        <tbody>
        {% for volontaire in volontaires %}
            <tr>
                <td>{{ volontaire.id }}</td>
                <td>{{ volontaire.name }}</td>
                <td>{{ volontaire.lastName }}</td>
                <td>{{ volontaire.email }}</td>
                <td>{{ volontaire.phoneNum }}</td>
                <td>{{ volontaire.skills }}</td>
                <td>{{ volontaire.availability ? 'Yes' : 'No' }}</td>
                <td>
                    <div class="action-buttons">
                        <a name="button-a" href="{{ path('app_volontaire_show', {'id': volontaire.id}) }}" class="btn btn-primary">show</a>
                        <a name="button-a" href="{{ path('app_volontaire_edit', {'id': volontaire.id}) }}" class="btn btn-danger">edit</a>
                    </div>
                </td>

            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_volontaire_new') }}">Create new</a>
{% endblock %}
