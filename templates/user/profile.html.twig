{% extends 'base.html.twig' %}

{% block title %}Profil - {{ user.name }}{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="text-center">Profil  {{ user.name }}</h1>

        <div class="card mt-4 shadow-sm">
            <div class="card-body">
                <h5 class="card-title text-primary">Informations personnelles</h5>
                <p><strong>Nom :</strong> {{ user.lastName }}</p>
                <p><strong>Prénom :</strong> {{ user.name }}</p>
                <p><strong>Email :</strong> {{ user.email }}</p>
                <!-- Association -->
                    <!-- Volontaire -->

                <p><strong>Skills :</strong> {{ user.skills }}</p>
                <p><strong>Disponibilité :</strong> {% if user.availability %}
                        Oui
                    {% else %}
                        Non
                    {% endif %}</p>
                   <div class="action-buttons"> <a href="{{ path('app_volontaire_edit', {'id': user.id}) }}">Modifier profil</a></div>


            </div>
        </div>
    </div>
    <style>
        .text-primary{
            color: #4E9AEE !important;
        }
    </style>
{% endblock %}
