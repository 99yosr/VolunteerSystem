{% extends 'base.html.twig' %}

{% block title %}Association{% endblock %}

{% block body %}
    <h1>Association</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ association.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ association.nom }}</td>
            </tr>
            <tr>
                <th>DateCreation</th>
                <td>{{ association.dateCreation ? association.dateCreation|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>NumTel</th>
                <td>{{ association.numTel }}</td>
            </tr>
            <tr>
                <th>EmailAssociation</th>
                <td>{{ association.emailAssociation }}</td>
            </tr>
            <tr>
                <th>PasswordA</th>
                <td>{{ association.passwordA }}</td>
            </tr>
            <tr>
                <th>Local</th>
                <td>{{ association.local }}</td>
            </tr>
            <tr>
                <th>Ceo</th>
                <td>{{ association.ceo }}</td>
            </tr>
        </tbody>
    </table>

    <a name="button-a" href="{{ path('app_association_index') }}">back to list</a>

    <a name="button-a" href="{{ path('app_association_edit', {'id': association.id}) }}">edit</a>

    {{ include('association/_delete_form.html.twig') }}
{% endblock %}
