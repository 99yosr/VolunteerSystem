{% extends 'base.html.twig' %}

{% block title %}Association index{% endblock %}

{% block body %}
    <h1>Association index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>DateCreation</th>
                <th>NumTel</th>
                <th>EmailAssociation</th>
                <th>PasswordA</th>
                <th>Local</th>
                <th>Ceo</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for association in associations %}
            <tr>
                <td>{{ association.id }}</td>
                <td>{{ association.nom }}</td>
                <td>{{ association.dateCreation ? association.dateCreation|date('Y-m-d') : '' }}</td>
                <td>{{ association.numTel }}</td>
                <td>{{ association.emailAssociation }}</td>
                <td>{{ association.passwordA }}</td>
                <td>{{ association.local }}</td>
                <td>{{ association.ceo }}</td>
                <td class="action-buttons">
                    <a name="button-a" href="{{ path('app_association_show', {'id': association.id}) }}">show</a>
                    <a name="button-a" href="{{ path('app_association_edit', {'id': association.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_association_new') }}">Create new</a>
{% endblock %}
