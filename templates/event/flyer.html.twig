<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ flyerData.title }}</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
</head>
<style>
    /*body {
        background: url({{ flyerData.background }}) no-repeat center center;
        background-size: cover; /* Assure que l'image couvre tout l'arrière-plan */
        /*height: 100vh; /* Ajuste la hauteur pour remplir la fenêtre */
       /* width: 100vw; /* Ajuste la largeur pour remplir la fenêtre */
       /* margin: 0; /* Supprime les marges du body */
