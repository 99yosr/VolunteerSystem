{% extends 'user/dashboard.html.twig' %}

{% block title %}Event{% endblock %}

{% block body %}
    <style>
        .titre-event {
            margin-top: 30px !important;
            margin-left: 300px !important; /* Pour déplacer le titre vers le bas */
            font-size: 1.5rem;
            color: #272D5B; /* Bleu foncé */
            text-transform: uppercase;
            font-weight: 600;
            margin-bottom: 40px;
        }
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            background-color: #f9f9f9;
        }
    </style>
    <h2 class="titre-event">Détails Evenement</h2>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ event.id }}</td>
            </tr>
            <tr>
                <th>Nom Evenement</th>
                <td>{{ event.nameEvent }}</td>
            </tr>
            <tr>
                <th>Date Début Evenement</th>
                <td>{{ event.dateEvent ? event.dateEvent|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Date Fin Evenement</th>
                <td>{{ event.dateEventF ? event.dateEventF|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Adresse</th>
                <td>{{ event.location }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ event.description }}</td>
            </tr>
        </tbody>
    </table>
<div class="action-buttons" style="margin-top: 50px;">
    <a href="{{ path('app_event_list') }}">Retourner à La Liste</a>

    <a href="{{ path('app_event_edit', {'id': event.id}) }}">Modifier</a>
</div>
    {{ include('event/_delete_form.html.twig') }}
{% endblock %}
{% block script %}{% endblock %}
{% block script2 %}{% endblock %}
